{
  "name": "ms-enterprises-backend",
  "version": "1.0.0",
  "description": "Backend API for MS Enterprises & Jaksh E-commerce platform",
  "main": "server.js",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "lambda": "node lambda.js",
    "build": "npm install --production",
    "build:lambda": "rm -f backend.zip && npm ci --omit=dev && zip -r backend.zip . -x \"backend.zip\" -x \"*.log\" -x \".env*\" -x \"README.md\" -x \"**/.git/**\" -x \"**/.DS_Store\" -x \"node_modules/.cache/**\" -x \"tests/**\" -x \".vscode/**\" -x \"*.test.js\"",
    "package": "npm run build:lambda",
    "deploy": "npm run build:lambda && mv backend.zip ../terraform/ && echo '✅ Package ready for deployment in terraform/backend.zip'",
    "clean": "rm -rf node_modules backend.zip package-lock.json",
    "clean:install": "npm run clean && npm install",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "check": "npm run lint && npm test"
  },
  "keywords": [
    "ecommerce",
    "api",
    "mern",
    "backend",
    "express",
    "mongodb",
    "razorpay",
    "aws-lambda"
  ],
  "author": "MS Enterprises",
  "license": "ISC",
  "dependencies": {
    "aws-sdk": "^2.1692.0",
    "bcryptjs": "^3.0.2",
    "connect-mongo": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^7.4.1",
    "express-session": "^1.18.2",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.20.0",
    "mongoose": "^8.18.2",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.6",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "path-to-regexp": "^0.1.7",
    "razorpay": "^2.9.6",
    "serverless-http": "^3.2.0",
    "sharp": "^0.34.4",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "supertest": "^6.3.4"
  },
  "nodemonConfig": {
    "watch": [
      "*.js",
      "routes/**/*.js",
      "controllers/**/*.js",
      "models/**/*.js",
      "middleware/**/*.js",
      "config/**/*.js",
      "utils/**/*.js",
      "services/**/*.js"
    ],
    "ext": "js,json",
    "ignore": [
      "node_modules/**",
      "tests/**",
      "*.test.js",
      "backend.zip"
    ],
    "env": {
      "NODE_ENV": "development"
    },
    "delay": 1000
  },
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "testMatch": [
      "**/__tests__/**/*.js",
      "**/?(*.)+(spec|test).js"
    ]
  }
}