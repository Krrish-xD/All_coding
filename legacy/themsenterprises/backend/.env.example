# Environment
NODE_ENV=development

# Server Configuration
PORT=5000
FRONTEND_URL=http://localhost:3000

# Database
MONGO_URI=mongodb://localhost:27017/ms-enterprises-ecommerce

# Session
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email Service (for notifications)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-email-password

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_TEST_KEY_ID=your-razorpay-test-key-id
RAZORPAY_TEST_KEY_SECRET=your-razorpay-test-key-secret

# Webhook Secrets
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
RAZORPAY_TEST_WEBHOOK_SECRET=your-test-webhook-secret

# Admin Credentials (for initial setup)
ADMIN_EMAIL=admin@themsenterprises.com
ADMIN_PASSWORD=admin123

# Brevo SMTP configuration
BREVO_HOST=smtp-relay.brevo.com
BREVO_PORT=XXX
BREVO_USER=XXXXXXX@smtp-brevo.com
BREVO_SMTP_KEY=your-brevo-smtp-key-here
BREVO_FROM_EMAIL=XXXX@themsenterprises.com

# CORS Origins (comma-separated for multiple)
CORS_ORIGIN=http://localhost:3000,https://app.themsenterprises.com
