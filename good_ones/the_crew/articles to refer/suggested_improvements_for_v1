pythondef save_checkpoint(cfg: SessionConfig, all_rounds: List[Dict], checkpoint_name: str):
    """Save progress to resume if interrupted"""
    checkpoint_path = os.path.join(cfg.session_dir, f"checkpoint_{checkpoint_name}.json")
    json_dump(checkpoint_path, {
        'rounds': all_rounds,
        'timestamp': now_iso(),
        'completed': checkpoint_name
    })

def load_checkpoint(session_dir: str) -> Optional[Dict]:
    """Resume from last checkpoint if available"""
    checkpoints = sorted([f for f in os.listdir(session_dir) if f.startswith('checkpoint_')])
    if checkpoints:
        with open(os.path.join(session_dir, checkpoints[-1])) as f:
            return json.load(f)
    return None
Why: Long research sessions can fail; don't lose work. Resume capability.

