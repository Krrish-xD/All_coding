1. Add Source Quality Scoring
pythondef score_source_quality(url: str, text: str) -> int:
    """Score source reliability 1-5 based on domain and content"""
    score = 3  # baseline
    
    # Boost for academic/authoritative domains
    if any(d in url.lower() for d in ['.edu', '.gov', 'arxiv.org', 'nature.com', 'science.org']):
        score += 2
    
    # Boost for established news/media
    elif any(d in url.lower() for d in ['reuters.com', 'apnews.com', 'bbc.com', 'nytimes.com']):
        score += 1
    
    # Penalize for low-quality indicators
    if any(d in url.lower() for d in ['blog', 'wordpress', 'medium.com']):
        score -= 1
    
    # Content quality signals
    if len(text) > 3000 and any(word in text.lower() for word in ['study', 'research', 'data', 'analysis']):
        score += 1
    
    return max(1, min(5, score))
Why: Prioritize high-quality sources in summarization, weight evidence appropriately.

2. Implement Smart Caching
python# Cache search results and scraped content
CACHE_DIR = os.path.join(DATA_ROOT, ".cache")

def get_cached_scrape(url: str) -> Optional[str]:
    """Check if we've scraped this URL in the last 7 days"""
    cache_key = hashlib.md5(url.encode()).hexdigest()
    cache_file = os.path.join(CACHE_DIR, f"{cache_key}.json")
    
    if os.path.exists(cache_file):
        with open(cache_file) as f:
            data = json.load(f)
            # Check if less than 7 days old
            if time.time() - data['timestamp'] < 7 * 24 * 3600:
                return data['text']
    return None
Why: Avoid re-scraping same URLs across sessions, faster iteration, respectful of websites.

3. Add Question Deduplication
pythondef dedupe_questions(new_questions: List[str], previous_questions: List[str]) -> List[str]:
    """Remove semantically similar questions using simple keyword overlap"""
    unique = []
    all_prev = ' '.join(previous_questions).lower()
    
    for q in new_questions:
        keywords = set(re.findall(r'\b\w{4,}\b', q.lower()))
        prev_keywords = set(re.findall(r'\b\w{4,}\b', all_prev))
        
        # If less than 60% keyword overlap, consider it unique
        overlap = len(keywords & prev_keywords) / len(keywords) if keywords else 0
        if overlap < 0.6:
            unique.append(q)
    
    return unique
Why: Prevent wasting rounds on essentially the same questions.

4. Add Diversity Enforcement in Search
pythondef diversify_urls(urls: List[str], max_per_domain: int = 3) -> List[str]:
    """Limit URLs from same domain to ensure source diversity"""
    from collections import defaultdict
    domain_counts = defaultdict(int)
    diverse = []
    
    for url in urls:
        domain = urlparse(url).netloc
        if domain_counts[domain] < max_per_domain:
            diverse.append(url)
            domain_counts[domain] += 1
    
    return diverse
Why: Avoid echo chambers, get multiple perspectives, better coverage.

