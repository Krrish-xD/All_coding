7. Implement Query Expansion for Better Search
pythondef expand_query(question: str, topic: str) -> List[str]:
    """Generate multiple search queries for the same question"""
    queries = [question]
    
    # Add topic context
    queries.append(f"{topic} {question}")
    
    # Add academic variant
    queries.append(f"{question} research study")
    
    # Add recent variant
    queries.append(f"{question} 2024 2025")
    
    return queries

# Then in search_for_question, try multiple queries and merge results
Why: Single query might miss relevant sources, multiple angles find more.

